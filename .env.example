# Copie para .env e preencha com os dados do seu Azure SQL Database
# (Portal do Azure > Banco de dados SQL > Cadeias de conexao > JDBC).
DB_URL=jdbc:sqlserver://<servidor>.database.windows.net:1433;database=<banco>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=60
DB_USERNAME=<usuario>
DB_PASSWORD=<sua-senha>

# Opcionais
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Supabase Storage. URL: Project Settings > Data API > Project URL (so a raiz, sem /rest/v1).
# Chave: Project Settings > API Keys > Secret key (sb_secret_...) ou a legacy service_role.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=pecas

# Autenticacao JWT. Segredo com 32+ caracteres (gere com: openssl rand -base64 48).
JWT_SECRET=<segredo-longo-e-aleatorio>
# Opcional: validade do token no formato ISO-8601 (padrao 2 horas)
JWT_EXPIRACAO=PT2H

# Envio de email (SMTP) para o codigo OTP. No Gmail, use uma senha de app
# (Conta Google > Seguranca > Senhas de app), nao a senha da conta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<seu-email@gmail.com>
MAIL_PASSWORD=<senha-de-app>
# Opcional: remetente exibido (padrao: MAIL_USERNAME)
# MAIL_FROM=PECA <nao-responda@seudominio.com>
