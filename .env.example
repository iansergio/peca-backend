# Opcional: o docker-compose.yml ja tem padroes para rodar local. Copie para .env so para mudar algo.

# PostgreSQL. DB_URL so e usado ao rodar a API fora do Docker (./mvnw spring-boot:run);
# no Compose a API aponta para o servico "postgres".
DB_URL=jdbc:postgresql://localhost:5432/peca
DB_USERNAME=peca
DB_PASSWORD=peca

# Autenticacao JWT. Segredo com 32+ caracteres (gere com: openssl rand -base64 48).
JWT_SECRET=segredo-de-desenvolvimento-local-troque-se-for-expor
# Opcional: validade do token no formato ISO-8601 (padrao 2 horas)
# JWT_EXPIRACAO=PT2H

# Envio de email real do codigo OTP (SMTP). No Gmail, use uma senha de app
# (Conta Google > Seguranca > Senhas de app), nao a senha da conta.
# Sem estas linhas, os emails vao para o Mailpit local (http://localhost:8025).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<seu-email@gmail.com>
# MAIL_PASSWORD=<senha-de-app>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# Opcional: remetente exibido (padrao: MAIL_USERNAME)
# MAIL_FROM=PECA <seu-email@gmail.com>

# Opcionais (padroes de application.properties, bons para rodar fora do Docker):
# JPA_SHOW_SQL=false
# STORAGE_DIR=./dados/imagens
# STORAGE_URL_PUBLICA=/imagens
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Caminho do repositorio do front-end, se nao estiver em ../peca-front-end
# FRONTEND_DIR=../peca-front-end
