# PostgreSQL do Supabase pelo pooler (Supavisor) em modo sessao, porta 5432
# (Supabase > Connect > Session pooler). O usuario leva o ref do projeto: postgres.<ref-do-projeto>.
# A conexao direta db.<ref>.supabase.co e so IPv6 e nao funciona no Azure App Service.
DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<ref-do-projeto>
DB_PASSWORD=<senha-do-banco>
# Alternativa sem Supabase: PostgreSQL local do docker-compose (perfil banco-local, veja o README).
# DB_URL=jdbc:postgresql://postgres-local:5432/peca
# DB_USERNAME=postgres
# POSTGRES_PASSWORD=<senha-do-banco-local>

# Opcionais
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Supabase Storage. URL: Project Settings > Data API > Project URL (so a raiz, sem /rest/v1).
# Chave: Project Settings > API Keys > Secret key (sb_secret_...) ou a legacy service_role.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=pecas

# Autenticacao JWT. Segredo com 32+ caracteres (gere com: openssl rand -base64 48).
JWT_SECRET=<segredo-longo-e-aleatorio>
# Opcional: validade do token no formato ISO-8601 (padrao 2 horas)
JWT_EXPIRACAO=PT2H

# Envio de email (SMTP) para o codigo OTP. No Gmail, use uma senha de app
# (Conta Google > Seguranca > Senhas de app), nao a senha da conta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<seu-email@gmail.com>
MAIL_PASSWORD=<senha-de-app>
# Opcional: remetente exibido (padrao: MAIL_USERNAME)
# MAIL_FROM=PECA <nao-responda@seudominio.com>

# CORS: origens do front-end que podem chamar a API pelo navegador, separadas por virgula.
# Troque pela URL de producao do front (ex: https://peca.app). Nunca use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
