# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > Database > Connection string > JDBC).
DB_URL=jdbc:postgresql://<host>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<sua-senha>

# Opcionais
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Supabase Storage (Project Settings > API). Use a chave service_role (secreta).
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=pecas
